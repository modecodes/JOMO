{
  "name": "jomo-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "JOMO: the privacy layer for Robinhood Chain. Private transactions for any token, from any app, assistant or AI agent.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "build:sdk": "pnpm --filter @jomo/sdk build",
    "build:web": "pnpm --filter @jomo/web build",
    "dev:web": "pnpm --filter @jomo/web dev",
    "test": "pnpm --filter @jomo/sdk test && pnpm --filter @jomo/mcp test && pnpm --filter @jomo/contracts test",
    "test:sdk": "pnpm --filter @jomo/sdk test",
    "test:contracts": "pnpm --filter @jomo/contracts test",
    "typecheck": "pnpm -r run typecheck",
    "demo": "pnpm --filter @jomo/example-agent-to-agent start",
    "test:mcp": "pnpm --filter @jomo/mcp test",
    "build:mcp": "pnpm --filter @jomo/mcp build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
